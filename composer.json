{
    "name": "gyyamzaki/recycle-here",
    "description": "Portal para localização e gerenciamento de pontos de coleta de materiais recicláveis.",
    "type": "project",
    "license": "proprietary",

    "require": {
        "php": "^8.2",
        "vlucas/phpdotenv": "^5.6"
    },

    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },

    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },

    "config": {
        "sort-packages": true
    }
}